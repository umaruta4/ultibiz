# UltiBiz — the environment of the service.
#
# Copy this file to `.env` (mode 600) on the server; the systemd unit reads it
# (EnvironmentFile=). The file itself is git-ignored — never commit the real
# one. Every value can also be given as an environment variable of the process.
#
# Generate a secret:  openssl rand -hex 32

# --- the application database -------------------------------------------------
ULTIBIZ_DB_HOST=localhost
ULTIBIZ_DB_PORT=3311
ULTIBIZ_DB_NAME=ultibiz
ULTIBIZ_DB_USER=ultibiz
ULTIBIZ_DB_PASSWORD=

# --- the administrator of MariaDB ---------------------------------------------
# only needed for the provisioning of a tenant database
ULTIBIZ_DB_ADMIN_USER=root
ULTIBIZ_DB_ADMIN_PASSWORD=

# --- the root account of MariaDB ----------------------------------------------
# the backup and the restore drill
MARIADB_ROOT_PASSWORD=

# --- the first administrator of the application -------------------------------
ULTIBIZ_ADMIN_PASSWORD=

# --- the key under which the secrets are sealed (AES-GCM) ---------------------
# the API keys of the assistant and the e-mail secrets; without it no secret
# can be saved
ULTIBIZ_AI_ENCRYPTION_KEY=

# --- the tenancy --------------------------------------------------------------
# single = one database for every organisation (the default)
# database = one database per tenant (the routing is active)
ULTIBIZ_TENANT_MODE=single

# --- the single sign-on (OpenID Connect / Keycloak) ---------------------------
# switch it on with ULTIBIZ_SSO_ENABLED=true (the profile sso of Spring Boot
# does the same)
ULTIBIZ_SSO_ENABLED=false
ULTIBIZ_SSO_ISSUER=
ULTIBIZ_SSO_CLIENT_ID=ultibiz
ULTIBIZ_SSO_CLIENT_SECRET=
ULTIBIZ_SSO_REDIRECT_URI=
ULTIBIZ_SSO_AUTO_PROVISION=true
ULTIBIZ_SSO_ORGANIZATION=ACME
ULTIBIZ_SSO_ROLE=USER
ULTIBIZ_SSO_ADMIN_ROLES=ultibiz-admin,admin

# --- the fallback of the e-mail (the transport of the interface wins) ---------
# the provider: mandrill | sendgrid | mailgun | webhook
ULTIBIZ_EMAIL_PROVIDER=
ULTIBIZ_SMTP_HOST=
ULTIBIZ_SMTP_PORT=587
ULTIBIZ_SMTP_USER=
ULTIBIZ_SMTP_PASSWORD=
ULTIBIZ_SMTP_FROM=ultibiz@localhost
ULTIBIZ_MAILGUN_DOMAIN=
ULTIBIZ_MAILGUN_REGION=us
ULTIBIZ_EMAIL_WEBHOOK_URL=
ULTIBIZ_EMAIL_WEBHOOK_SECRET=

# --- the exchange -------------------------------------------------------------
# the shared secret the partners send in the X-Exchange-Secret header
ULTIBIZ_EXCHANGE_WEBHOOK_SECRET=

# --- the reports and the rate limit -------------------------------------------
ULTIBIZ_REPORT_DIR=/var/lib/ultibiz/reports
ULTIBIZ_DASHBOARD_DELIVERY_WEBHOOK=
ULTIBIZ_RATE_LIMIT_REQUESTS=60
ULTIBIZ_RATE_LIMIT_WINDOW=60
